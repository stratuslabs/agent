{
  "name": "@stratusagent/cli",
  "version": "0.2.1",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "stratus": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "cli": "node --experimental-strip-types ./src/bin.ts",
    "typecheck": "tsc --noEmit --project tsconfig.test.json",
    "test": "node --test --experimental-strip-types ./test/**/*.test.ts"
  },
  "dependencies": {
    "@stratusagent/core": "workspace:*",
    "@stratusagent/executor-local": "workspace:*",
    "@stratusagent/providers": "workspace:*",
    "@stratusagent/provider-anthropic": "workspace:*",
    "@stratusagent/agents": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.6.0",
    "typescript": "^5.9.3"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stratuslabs/agent.git",
    "directory": "packages/cli"
  },
  "description": "Stratus Agent CLI: setup walkthrough, agent creation, local runs, and dashboard",
  "keywords": [
    "stratus",
    "agent",
    "ai",
    "llm"
  ],
  "publishConfig": {
    "access": "public"
  }
}
