{
  "name": "@stratusagent/tool-fs",
  "version": "0.14.2",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit --project tsconfig.test.json",
    "test": "node --test --experimental-strip-types"
  },
  "engines": {
    "node": ">=22.16 <23 || >=24"
  },
  "dependencies": {
    "@stratusagent/core": "workspace:*",
    "@stratusagent/plugins": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.6.0",
    "typescript": "^7.0.2"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stratuslabs/agent.git",
    "directory": "packages/tool-fs"
  },
  "description": "Filesystem tools for Stratus agents: read, list, search, and write inside per-agent roots, with symlink-safe containment",
  "keywords": [
    "stratus",
    "agent",
    "ai",
    "llm",
    "stratus-plugin",
    "tools",
    "filesystem"
  ],
  "publishConfig": {
    "access": "public"
  },
  "stratus": {
    "pluginVersion": 1,
    "contributes": {
      "tools": [
        {
          "name": "fs.read",
          "risk": "safe"
        },
        {
          "name": "fs.list",
          "risk": "safe"
        },
        {
          "name": "fs.search",
          "risk": "safe"
        },
        {
          "name": "fs.write",
          "risk": "gated"
        },
        {
          "name": "fs.move",
          "risk": "gated"
        }
      ]
    },
    "config": {
      "type": "object",
      "properties": {
        "roots": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "maxBytes": {
          "type": "integer"
        },
        "maxMatches": {
          "type": "integer"
        },
        "maxEntries": {
          "type": "integer"
        },
        "workspaceRoot": {
          "type": "string"
        },
        "ledgerRoot": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  }
}
