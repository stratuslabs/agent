{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "composite": false,
    "allowImportingTsExtensions": true,
    "rootDir": "."
  },
  // Every test file, helpers included: a shared harness that is not
  // typechecked is exactly where a stale stub survives.
  "include": ["src/**/*.ts", "test/**/*.ts"],
  "exclude": ["dist"]
}
