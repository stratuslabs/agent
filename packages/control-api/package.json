{
  "name": "@stratusagent/control-api",
  "version": "0.10.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit --project tsconfig.test.json",
    "test": "node --test --experimental-strip-types ./test/**/*.test.ts"
  },
  "engines": {
    "node": ">=22.13 <23 || >=23.4"
  },
  "dependencies": {
    "@stratusagent/agents": "workspace:*",
    "@stratusagent/core": "workspace:*",
    "@stratusagent/gateway": "workspace:*",
    "@stratusagent/provider-anthropic": "workspace:*",
    "@stratusagent/state": "workspace:*",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@stratusagent/dashboard": "workspace:*",
    "@types/node": "^24.6.0",
    "@types/ws": "^8.5.13",
    "typescript": "^5.9.3"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stratuslabs/agent.git",
    "directory": "packages/control-api"
  },
  "description": "The Stratus control API: one authenticated HTTP + WebSocket surface over a running stratusd, consumed by the web dashboard and the macOS app alike",
  "keywords": [
    "stratus",
    "agent",
    "ai",
    "llm",
    "api"
  ],
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@stratusagent/dashboard": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@stratusagent/dashboard": {
      "optional": true
    }
  }
}
