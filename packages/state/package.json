{
  "name": "@stratusagent/state",
  "version": "0.9.2",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit --project tsconfig.test.json",
    "test": "node --test --experimental-strip-types"
  },
  "engines": {
    "node": ">=22.13 <23 || >=23.4"
  },
  "dependencies": {
    "@stratusagent/agents": "workspace:*",
    "@stratusagent/core": "workspace:*",
    "@stratusagent/executor-local": "workspace:*",
    "@stratusagent/provider-anthropic": "workspace:*",
    "@stratusagent/provider-claude-code": "workspace:*",
    "@stratusagent/provider-codex": "workspace:*",
    "@stratusagent/providers": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.6.0",
    "typescript": "^5.9.3"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stratuslabs/agent.git",
    "directory": "packages/state"
  },
  "description": "Shared Stratus state wiring: config resolution, credential storage, the soul roster, file-backed agent memory, and provider construction \u2014 used by the CLI and the gateway alike",
  "keywords": [
    "stratus",
    "agent",
    "ai",
    "llm"
  ],
  "publishConfig": {
    "access": "public"
  }
}
