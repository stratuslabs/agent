{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "composite": false,
    "allowImportingTsExtensions": true,
    "rootDir": "."
  },
  "references": [
    {
      "path": "../core"
    },
    {
      "path": "../providers"
    },
    {
      "path": "../plugins"
    },
    {
      "path": "../state"
    }
