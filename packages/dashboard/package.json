{
  "name": "@stratusagent/dashboard",
  "version": "0.11.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "ui"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit --project tsconfig.test.json",
    "test": "node --test --experimental-strip-types ./test/**/*.test.ts"
  },
  "engines": {
    "node": ">=22.13 <23 || >=23.4"
  },
  "devDependencies": {
    "@types/node": "^24.6.0",
    "typescript": "^5.9.3"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stratuslabs/agent.git",
    "directory": "packages/dashboard"
  },
  "description": "The Stratus web dashboard: a static, build-step-free UI served by @stratusagent/control-api \u2014 roster, live chat, approvals, and settings",
  "keywords": [
    "stratus",
    "agent",
    "ai",
    "llm",
    "dashboard"
  ],
  "publishConfig": {
    "access": "public"
  }
}
