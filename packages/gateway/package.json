{
  "name": "@stratusagent/gateway",
  "version": "0.9.1",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "launchd"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit --project tsconfig.test.json",
    "test": "node --test --experimental-strip-types"
  },
  "engines": {
    "node": ">=22.13 <23 || >=23.4"
  },
  "dependencies": {
    "@stratusagent/agents": "workspace:*",
    "@stratusagent/core": "workspace:*",
    "@stratusagent/executor-local": "workspace:*",
    "@stratusagent/plugins": "workspace:*",
    "@stratusagent/state": "workspace:*"
  },
  "devDependencies": {
    "@stratusagent/permissions": "workspace:*",
    "@types/node": "^24.6.0",
    "typescript": "^5.9.3"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stratuslabs/agent.git",
    "directory": "packages/gateway"
  },
  "description": "stratusd \u2014 the always-on Stratus Agent gateway: durable SQLite sessions, a per-provider runner pool, dispatcher-backed delegation, and an activity watchdog",
  "keywords": [
    "stratus",
    "agent",
    "ai",
    "llm",
    "daemon"
  ],
  "publishConfig": {
    "access": "public"
  }
}
