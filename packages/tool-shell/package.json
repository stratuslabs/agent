{
  "name": "@stratusagent/tool-shell",
  "version": "0.14.2",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit --project tsconfig.test.json",
    "test": "node --test --experimental-strip-types"
  },
  "engines": {
    "node": ">=22.16 <23 || >=24"
  },
  "dependencies": {
    "@stratusagent/agents": "workspace:*",
    "@stratusagent/core": "workspace:*",
    "@stratusagent/executor-local": "workspace:*",
    "@stratusagent/plugins": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^5.9.3",
    "@stratusagent/permissions": "workspace:*"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stratuslabs/agent.git",
    "directory": "packages/tool-shell"
  },
  "description": "Shell execution for Stratus agents: shell.run on the local-command executor, with a replaced environment, a pinned cwd, and bounded output",
  "keywords": [
    "stratus",
    "agent",
    "ai",
    "llm",
    "stratus-plugin",
    "tools",
    "shell"
  ],
  "publishConfig": {
    "access": "public"
  },
  "stratus": {
    "pluginVersion": 1,
    "contributes": {
      "tools": [
        {
          "name": "shell.run",
          "risk": "gated"
        }
      ]
    },
    "config": {
      "type": "object",
      "properties": {
        "cwd": {
          "type": "string"
        },
        "passEnv": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "env": {
          "type": "object"
        },
        "timeoutMs": {
          "type": "integer"
        },
        "maxOutputBytes": {
          "type": "integer"
        },
        "shell": {
          "type": "string"
        },
        "workspaceRoot": {
          "type": "string"
        },
        "sandbox": {
          "type": "string",
          "enum": ["auto", "required", "off"]
        },
        "deniedPaths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "writablePaths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "home": {
          "type": "string",
          "enum": ["hidden", "visible"]
        },
        "readablePaths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "credentialsEnv": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "credentialsFromConfig": "credentialsEnv",
    "envBindings": true
  }
}
