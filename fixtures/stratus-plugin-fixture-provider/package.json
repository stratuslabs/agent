{
  "name": "stratus-plugin-fixture-provider",
  "version": "0.0.0",
  "private": true,
  "description": "A plugin contributing a provider, so the provider seam can be tested through the real loader.",
  "type": "module",
  "exports": "./index.js",
  "stratus": {
    "pluginVersion": 1,
    "contributes": {
      "providers": [
        { "name": "fixture" }
      ]
    },
    "config": {
      "type": "object",
      "properties": {
        "reply": { "type": "string" },
        "mode": { "type": "string", "enum": ["echo", "memory"] }
      },
      "additionalProperties": false
    }
  }
}
