{
  "name": "stratus",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.18.3",
  "scripts": {
    "build": "pnpm -r build",
    "cli": "pnpm --filter @stratusagent/cli run cli",
    "demo": "pnpm cli run --prompt \"please use the echo tool\"",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "eval:room": "pnpm --filter @stratusagent/cli run eval:room",
    "eval:defaults": "pnpm --filter @stratusagent/cli run eval:defaults"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stratuslabs/agent.git"
  },
  "devDependencies": {
    "stratus-plugin-aliased": "workspace:stratus-plugin-fixture@*",
    "stratus-plugin-fixture": "workspace:*",
    "stratus-plugin-fixture-channel": "workspace:*",
    "stratus-plugin-fixture-channel-twin": "workspace:stratus-plugin-fixture-channel@*",
    "stratus-plugin-fixture-executor": "workspace:*",
    "stratus-plugin-fixture-memory": "workspace:*",
    "stratus-plugin-fixture-provider": "workspace:*"
  }
}
